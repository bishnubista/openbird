# Python
__pycache__/
*.py[cod]
.venv/
.uv-cache/
*.egg-info/
.pytest_cache/
build/
dist/

# Swift
.build/
*/.build/
*.xcodeproj

# OpenBird local data (never commit a user's captured memory)
.openbird/
*.db
*.db-wal
*.db-shm
*.sqlite

# OS / editor
.DS_Store
.idea/
.vscode/

# Secrets
.env
.env.*

# SwiftPM scratch cache (from sandboxed builds)
.swift-cache/

# Local dmg-release overrides (non-secret config; auto-derived by default)
script/release.env

# Claude Code runtime artifacts
.claude/scheduled_tasks.lock
.claude/scheduled_tasks.json

# E2E screenshot captures (regenerate with script/e2e_screenshots.sh)
e2e/screenshots/*.png
