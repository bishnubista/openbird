<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!--
    The audio-helper opens the microphone via AVAudioEngine. Under the hardened
    runtime, microphone access requires this entitlement in addition to the
    NSMicrophoneUsageDescription string embedded in the helper binary.
  -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
  <!-- Helpers link only system frameworks, but keep parity with the app so a
       future bundled dylib does not trip hardened-runtime validation. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <!--
    The capture-helper reads the active browser tab's URL via Apple Events
    (opt-in, --capture-urls). Under the hardened runtime a Developer ID binary
    sending Apple Events is BLOCKED even after the user grants Automation consent
    unless it carries this entitlement; the NSAppleEventsUsageDescription string
    is embedded in the helper's Info.plist. (audio-helper does not script apps,
    but the two share this single Helper.entitlements file — harmless for it.)
  -->
  <key>com.apple.security.automation.apple-events</key>
  <true/>
</dict>
</plist>
