<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!--
    Applied ONLY to the embedded Python interpreter(s) in the notarized .dmg
    bundle (Contents/Resources/python/bin/python3*). The interpreter dlopen()s
    third-party C extension modules (sqlite-vec, sqlcipher, …); some wheels ship
    dylibs that won't reliably re-sign to our Team ID, so library validation must
    be relaxed on the *process that loads them* (per hardened-runtime semantics),
    not merely on the app. See docs/design/notarized-dmg-distribution.md.
  -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <!-- MLX compiles Metal kernels at runtime. Keep this exception scoped to the
       embedded Python host; Apple recommends MAP_JIT + allow-jit for Python
       frameworks instead of the broader unsigned-executable-memory escape. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <!-- MLX 0.32 also maps generated Metal support code without MAP_JIT. This is
       broader than allow-jit, so it remains confined to the child interpreter
       and is never applied to OpenBird.app or either capture helper. -->
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
</dict>
</plist>
