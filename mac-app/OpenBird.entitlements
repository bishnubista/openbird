<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!--
    The app shells out to the bundled helpers and the openbird CLI (uv/python).
    Disabling library validation lets a self-signed bundle launch child
    executables/dylibs that are not signed by the same identity (e.g. the
    Homebrew-managed Python venv) without being killed by the hardened runtime.
  -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <!-- Allow spawning the helper/CLI child processes under the hardened runtime. -->
  <key>com.apple.security.cs.allow-dyld-environment-variables</key>
  <true/>
  <!--
    The app requests Microphone access from its own process (macOS attributes a
    nested helper's TCC request to the app bundle anyway). Under the hardened
    runtime the app therefore needs the audio-input entitlement, not just the
    helper. Paired with NSMicrophoneUsageDescription in the app Info.plist.
  -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
</dict>
</plist>
